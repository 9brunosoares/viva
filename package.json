{
  "name": "viva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/build-release.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "assets": "python scripts/prepare_assets.py",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts",
    "test:browser": "tsx tests/browser.ts",
    "build:qa": "tsc --noEmit && node scripts/build-qa.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
